{
  "manifest_version": 3,
  "name": "Claude Switcher",
  "version": "1.1.3",
  "description": "Switch between claude.ai accounts in one Chrome profile, and open artifacts that live in your other account.",
  "permissions": ["cookies", "storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://raw.githubusercontent.com/dreamiurg/claude-switcher/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://claude.ai/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Switch Claude account",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
